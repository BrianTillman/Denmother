# Generated by dm release build. Publish the matching archives before this formula.
class Denmother < Formula
  desc "Validate and test Home Assistant YAML automations"
  homepage "{{.Homepage}}"
  version "{{.Version}}"
  license "MIT"
{{range .Platforms}}
  on_{{.OS}} do
    on_{{.Arch}} do
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
    end
  end
{{end}}
  def install
    bin.install "dm"
    doc.install "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md",
                "ROADMAP.md", "THIRD_PARTY_NOTICES.md", "docs"
    pkgshare.install "examples", "skills", "evals", "scripts"
    generate_completions_from_executable(bin/"dm", "completion")
  end

  test do
    assert_match "Denmother #{version}", shell_output("#{bin}/dm version")
    cp_r pkgshare/"examples/quickstart", testpath/"quickstart"
    config = testpath/"quickstart/ha-config"
    system bin/"dm", "--config", config, "--no-schema"
    (config/"configuration.yaml").write("broken: [\n")
    assert_match "Validation failed", shell_output("#{bin}/dm --config #{config} --lint --no-schema", 1)
  end
end
